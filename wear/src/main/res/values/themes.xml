<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OemLauncher" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Theme.OemLauncher.Transparent" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
